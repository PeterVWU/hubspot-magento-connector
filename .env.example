# Magento
MAGENTO_BASE_URL=https://your-store.com/rest/V1
MAGENTO_TOKEN=your-magento-bearer-token

# HubSpot
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# PostgreSQL (for docker-compose, DATABASE_URL is set automatically)
# Only needed if running outside Docker:
DATABASE_URL=postgresql://hubspot_sync:changeme@localhost:5432/hubspot_sync
POSTGRES_PASSWORD=changeme

# Sync Settings
SYNC_INTERVAL_MINUTES=5
HUBSPOT_BATCH_SIZE=100
MAGENTO_PAGE_SIZE=100
# Only sync records updated after this date (ISO format). Remove to sync everything.
SYNC_START_DATE=2026-02-01

# Customer Filter
EXCLUDED_SALESREP_IDS=

# Logging
LOG_LEVEL=info
