# Magento
MAGENTO_BASE_URL=https://your-store.com/rest/V1
MAGENTO_TOKEN=your-magento-bearer-token

# HubSpot
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# PostgreSQL (for docker-compose, DATABASE_URL is set automatically)
# Only needed if running outside Docker:
DATABASE_URL=postgresql://hubspot_sync:changeme@localhost:5432/hubspot_sync
POSTGRES_PASSWORD=changeme

# Sync Settings
SYNC_INTERVAL_MINUTES=5
HUBSPOT_BATCH_SIZE=100
MAGENTO_PAGE_SIZE=100
# Only sync records updated after this date (ISO format). Remove to sync everything.
SYNC_START_DATE=2026-02-01
# Max records per entity per sync cycle. 0 = unlimited. Set to 5-10 for testing.
MAX_RECORDS_PER_SYNC=0

# Timeouts
# Per-request timeout for Magento API calls (ms). Default: 120000 (2 min)
MAGENTO_TIMEOUT_MS=120000
# Per-request timeout for HubSpot API calls (ms). Default: 30000 (30s)
HUBSPOT_TIMEOUT_MS=30000
# Max 429 rate-limit retries per HubSpot request. Default: 3
HUBSPOT_MAX_RETRIES=3
# Max duration for a full sync cycle (minutes). Default: 10
SYNC_TIMEOUT_MINUTES=10
# Max contacts processed per owner-reverse cycle. Caps the loop so it
# fits inside SYNC_TIMEOUT_MINUTES; the cursor still advances by exactly
# this many contacts each cycle until the backlog is drained. Default: 500
OWNER_REVERSE_BATCH_SIZE=500

# Customer Filter
EXCLUDED_SALESREP_IDS=81,97,143,121,73,130,131,129,128

# Logging
LOG_LEVEL=info
