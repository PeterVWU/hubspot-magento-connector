<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <listingToolbar name="listing_top">
        <massaction name="listing_massaction" component="Magento_Ui/js/grid/tree-massactions">
            <action name="export_to_hubspot">
                <settings>
                    <url path="hubintegration/massExport/product"/>
                    <type>export_to_hubspot</type>
                    <label translate="true">Export To HubSpot</label>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
    <columns name="product_columns"> 
        <actionsColumn name="hub_product_id" class="Makewebbetter\HubIntegration\Ui\Component\Listing\Column\Hubproduct" sortOrder="35">
            <settings> 
                <label translate="true">HubSpot Sync Action</label>
            </settings>
        </actionsColumn> 
    </columns>
</listing>
