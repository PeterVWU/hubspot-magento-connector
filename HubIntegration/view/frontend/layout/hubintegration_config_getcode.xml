<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <css src="Makewebbetter_HubIntegration::css/bootstrap.min.css" />
        <css src="Makewebbetter_HubIntegration::css/fontawesome.min.css" />
        <css src="Makewebbetter_HubIntegration::css/makewebbetter-stepper.css" />
    </head>
    <body>
        <referenceContainer name="page.wrapper" remove="true"/>
        <container name="hub_container" htmlClass="container_css_class" htmlTag="div">
            <block class="Makewebbetter\HubIntegration\Block\Authorize\Config"
                   name="hubspot_authorize_config"
                   template="authorize/config.phtml" />
        </container>
    </body>
</page>
